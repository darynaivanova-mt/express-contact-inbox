# Route contact-form submissions to the person maintaining the site.
# Copy to .env and fill in your own credentials. Never commit a populated .env.
# See docs/email-setup.md for provider settings. MAIL_MODE=log lets you try the development app without sending.

APP_URL=http://localhost:3000 # Origin of the contact page; incoming forms from other origins are rejected.
HOST=127.0.0.1 # Listener address; keep loopback for local use or configure it for your host.
PORT=3000 # Production HTTP port; keep APP_URL consistent with the address people actually use.
DB_PATH=.data/app.sqlite # Contact messages and their outgoing email records; SQLite file relative to the app directory. Preserve it across deployments.
ADMIN_PASSWORD= # Password for admin to inspect the contact inbox; generate a random value of at least 16 characters.
OWNER_EMAIL=owner@example.com # Destination for incoming contact messages; the visitor address is used for replies.
REVIEWER_EMAIL=reviewer@example.com # No reviewer recipient is needed for contact messages; leave blank if preferred.
MAIL_MODE=sandbox # sandbox captures contact messages; production sends them; log writes local previews in development.
MAIL_FROM=sender@example.com # Sender shown on contact messages. Live sending requires your verified Mailtrap domain.
MAILTRAP_PRODUCTION_TOKEN= # Mailtrap sending token used only when contact messages go through production mode.
MAILTRAP_SANDBOX_TOKEN= # API token with access to the Sandbox used for contact inbox messages.
MAILTRAP_INBOX_ID= # Numeric Sandbox ID from its API integration settings; captured contact email stays here.
